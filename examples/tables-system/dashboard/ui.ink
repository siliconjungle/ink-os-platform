module ink_ui;
enum UiKind {Column,Row,Panel,Heading,Text,Button,Field,Toggle,Select,List,Item,Table,TableHead,TableBody,TableRow,HeaderCell,Cell,Form,Navigation,NavItem,Component,}
enum UiFieldKind {Text,Number,Email,Url,Date,Multiline,}
enum UiEventKind {Activate,Input,Change,Submit,}
record UiOption {value:String,label:String,disabled:Bool,}
record UiFieldValue {name:String,text:String,checked:Bool,}
record UiInput {text:String,checked:Bool,fields:List<UiFieldValue>,}
record UiEvent<A> {node:String,kind:UiEventKind,action:A,input:UiInput,}
record UiData<R> {rows:List<R>,total:Option<u64>,version:u64,}
record UiNode<A> {id:String,kind:UiKind,children:List<String>,text:String,value:String,checked:Bool,disabled:Bool,label:String,description:String,selected:Bool,invalid:Bool,placeholder:String,fieldKind:UiFieldKind,options:List<UiOption>,activate:Option<A>,input:Option<A>,change:Option<A>,submit:Option<A>,component:String,}
record UiView<A> {root:String,nodes:List<UiNode<A>>,}
fn ui_node<A>(id:String,kind:UiKind)->UiNode<A>{return UiNode<A>{id:id,kind:kind,children:[],text:"",value:"",checked:false,disabled:false,label:"",description:"",selected:false,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:[],activate:None,input:None,change:None,submit:None,component:""};}
fn ui_group<A>(id:String,kind:UiKind,children:List<String>)->UiNode<A>{return UiNode<A>{id:id,kind:kind,children:children,text:"",value:"",checked:false,disabled:false,label:"",description:"",selected:false,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:[],activate:None,input:None,change:None,submit:None,component:""};}
fn ui_text<A>(id:String,text:String)->UiNode<A>{return UiNode<A>{id:id,kind:UiKind.Text,children:[],text:text,value:"",checked:false,disabled:false,label:"",description:"",selected:false,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:[],activate:None,input:None,change:None,submit:None,component:""};}
fn ui_heading<A>(id:String,text:String)->UiNode<A>{return UiNode<A>{id:id,kind:UiKind.Heading,children:[],text:text,value:"",checked:false,disabled:false,label:"",description:"",selected:false,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:[],activate:None,input:None,change:None,submit:None,component:""};}
fn ui_button<A>(id:String,text:String,action:A)->UiNode<A>{return UiNode<A>{id:id,kind:UiKind.Button,children:[],text:text,value:"",checked:false,disabled:false,label:"",description:"",selected:false,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:[],activate:Some(action),input:None,change:None,submit:None,component:""};}
fn ui_field<A>(id:String,label:String,value:String)->UiNode<A>{return UiNode<A>{id:id,kind:UiKind.Field,children:[],text:"",value:value,checked:false,disabled:false,label:label,description:"",selected:false,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:[],activate:None,input:None,change:None,submit:None,component:""};}
fn ui_form<A>(id:String,label:String,children:List<String>,action:A)->UiNode<A>{return UiNode<A>{id:id,kind:UiKind.Form,children:children,text:"",value:"",checked:false,disabled:false,label:label,description:"",selected:false,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:[],activate:None,input:None,change:None,submit:Some(action),component:""};}
fn ui_component<A>(id:String,component:String)->UiNode<A>{return UiNode<A>{id:id,kind:UiKind.Component,children:[],text:"",value:"",checked:false,disabled:false,label:"",description:"",selected:false,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:[],activate:None,input:None,change:None,submit:None,component:component};}
fn ui_toggle<A>(id:String,label:String,checked:Bool,action:A)->UiNode<A>{return UiNode<A>{id:id,kind:UiKind.Toggle,children:[],text:"",value:"",checked:checked,disabled:false,label:label,description:"",selected:false,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:[],activate:None,input:None,change:Some(action),submit:None,component:""};}
fn ui_select<A>(id:String,label:String,value:String,options:List<UiOption>,action:A)->UiNode<A>{return UiNode<A>{id:id,kind:UiKind.Select,children:[],text:"",value:value,checked:false,disabled:false,label:label,description:"",selected:false,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:options,activate:None,input:None,change:Some(action),submit:None,component:""};}
fn ui_nav_item<A>(id:String,text:String,selected:Bool,action:A)->UiNode<A>{return UiNode<A>{id:id,kind:UiKind.NavItem,children:[],text:text,value:"",checked:false,disabled:false,label:"",description:"",selected:selected,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:[],activate:Some(action),input:None,change:None,submit:None,component:""};}
fn ui_events<A>(node:UiNode<A>,activate:Option<A>,input:Option<A>,change:Option<A>,submit:Option<A>)->UiNode<A>{return UiNode<A>{id:node.id,kind:node.kind,children:node.children,text:node.text,value:node.value,checked:node.checked,disabled:node.disabled,label:node.label,description:node.description,selected:node.selected,invalid:node.invalid,placeholder:node.placeholder,fieldKind:node.fieldKind,options:node.options,activate:activate,input:input,change:change,submit:submit,component:node.component};}
fn ui_disabled<A>(node:UiNode<A>,disabled:Bool)->UiNode<A>{return UiNode<A>{id:node.id,kind:node.kind,children:node.children,text:node.text,value:node.value,checked:node.checked,disabled:disabled,label:node.label,description:node.description,selected:node.selected,invalid:node.invalid,placeholder:node.placeholder,fieldKind:node.fieldKind,options:node.options,activate:node.activate,input:node.input,change:node.change,submit:node.submit,component:node.component};}
fn ui_description<A>(node:UiNode<A>,description:String)->UiNode<A>{return UiNode<A>{id:node.id,kind:node.kind,children:node.children,text:node.text,value:node.value,checked:node.checked,disabled:node.disabled,label:node.label,description:description,selected:node.selected,invalid:node.invalid,placeholder:node.placeholder,fieldKind:node.fieldKind,options:node.options,activate:node.activate,input:node.input,change:node.change,submit:node.submit,component:node.component};}
fn ui_invalid<A>(node:UiNode<A>,invalid:Bool)->UiNode<A>{return UiNode<A>{id:node.id,kind:node.kind,children:node.children,text:node.text,value:node.value,checked:node.checked,disabled:node.disabled,label:node.label,description:node.description,selected:node.selected,invalid:invalid,placeholder:node.placeholder,fieldKind:node.fieldKind,options:node.options,activate:node.activate,input:node.input,change:node.change,submit:node.submit,component:node.component};}
fn ui_field_kind<A>(node:UiNode<A>,fieldKind:UiFieldKind)->UiNode<A>{return UiNode<A>{id:node.id,kind:node.kind,children:node.children,text:node.text,value:node.value,checked:node.checked,disabled:node.disabled,label:node.label,description:node.description,selected:node.selected,invalid:node.invalid,placeholder:node.placeholder,fieldKind:fieldKind,options:node.options,activate:node.activate,input:node.input,change:node.change,submit:node.submit,component:node.component};}
fn ui_option(value:String,label:String)->UiOption{return UiOption{value:value,label:label,disabled:false};}
fn ui_field_text(input:UiInput,name:String)->String{return input.fields.filter(fn(field)=>field.name==name).at_or(0,UiFieldValue{name:"",text:"",checked:false}).text;}
record UiDecimal {rest:u64,text:String,}
fn ui_digit(n:u64)->String{if(n==0){return "0";}if(n==1){return "1";}if(n==2){return "2";}if(n==3){return "3";}if(n==4){return "4";}if(n==5){return "5";}if(n==6){return "6";}if(n==7){return "7";}if(n==8){return "8";}return "9";}
fn ui_key(n:u64)->String{let value=repeat(20,UiDecimal{rest:n,text:""},fn(i,s)=>UiDecimal{rest:quot_or(s.rest,10,0),text:choose(s.rest>0||i==0,string_concat(ui_digit(rem_or(s.rest,10,0)),s.text),s.text)});return value.text;}
fn ui_submit<A>(id:String,text:String)->UiNode<A>{return UiNode<A>{id:id,kind:UiKind.Button,children:[],text:text,value:"",checked:false,disabled:false,label:"",description:"",selected:false,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:[],activate:None,input:None,change:None,submit:None,component:""};}
fn ui_item<A>(id:String,text:String,children:List<String>)->UiNode<A>{return UiNode<A>{id:id,kind:UiKind.Item,children:children,text:text,value:"",checked:false,disabled:false,label:"",description:"",selected:false,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:[],activate:None,input:None,change:None,submit:None,component:""};}

fn ui_cell<A>(id:String,text:String)->UiNode<A>{return UiNode<A>{id:id,kind:UiKind.Cell,children:[],text:text,value:"",checked:false,disabled:false,label:"",description:"",selected:false,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:[],activate:None,input:None,change:None,submit:None,component:""};}
fn ui_header<A>(id:String,text:String)->UiNode<A>{return UiNode<A>{id:id,kind:UiKind.HeaderCell,children:[],text:text,value:"",checked:false,disabled:false,label:"",description:"",selected:false,invalid:false,placeholder:"",fieldKind:UiFieldKind.Text,options:[],activate:None,input:None,change:None,submit:None,component:""};}
